# -----------------------------------------------------------------------------
# Configuración de MoodleShield para desarrollo local.
# Copia este fichero a .env y ajusta lo que necesites:  cp .env.example .env
# Genera los secretos con:  openssl rand -hex 32
# -----------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# URL pública tal y como la ve Moodle. En local con túnel, la del túnel.
# Moodle exige HTTPS: ver docs/https-tunel.md
PUBLIC_URL=http://localhost:3000
PORT=3000

# --- Base de datos ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=moodleshield
DB_USER=moodleshield
DB_PASSWORD=moodleshield

# --- Secretos (obligatorios en producción, mínimo 32 caracteres) ---
SESSION_SECRET=
WATERMARK_SECRET=
MEDIA_KEY_SECRET=
MEDIA_LINK_SECRET=

# Token para dar de alta plataformas por API (POST /lti/platforms).
# Si se deja vacío, ese endpoint queda deshabilitado.
LTI_ADMIN_TOKEN=

# --- Almacenamiento ---
MEDIA_ROOT=./.data/media
UPLOAD_ROOT=./.data/uploads
MAX_UPLOAD_BYTES=4294967296

# 'app'    → los segmentos los sirve Node (desarrollo, sin proxy delante)
# 'signed' → los sirve nginx validando secure_link (producción)
MEDIA_DELIVERY=app
MEDIA_PUBLIC_PREFIX=/media
MEDIA_LINK_TTL_SECONDS=14400

# --- Transcodificación ---
SEGMENT_SECONDS=4
OUTPUT_FPS=24
OUTPUT_CRF=21
OUTPUT_PRESET=veryfast
# 0.04–0.08 es imperceptible; sube a 0.5 para ver el patrón A/B en la demo
MARK_ALPHA=0.06
FFMPEG_NICE=10
TRANSCODE_CONCURRENCY=1
TRANSCODE_MAX_ATTEMPTS=3
TRANSCODE_POLL_MS=5000
# El heartbeat debe ser sensiblemente menor que el lease.
TRANSCODE_LEASE_SECONDS=90
TRANSCODE_HEARTBEAT_MS=20000
TRANSCODE_REAPER_MS=60000
STORAGE_RECONCILE_MS=900000
WORKER_SHUTDOWN_MS=30000
FFMPEG_KILL_GRACE_MS=5000

# --- LTI ---
# Parámetro personalizado de Moodle con el identificador visible del alumno.
# En Moodle se configura como:  username=$User.username
# (Moodle no envía el nombre de usuario en ningún claim estándar de LTI 1.3.)
LTI_IDENTITY_CUSTOM_PARAM=username
LTI_IDENTITY_MOODLE_SOURCE=$User.username

# --- Materiales PDF (T20) ---
# Límite propio: un PDF de 100 MB ya es enorme; un vídeo de 100 MB, corto.
MAX_PDF_BYTES=104857600
MAX_PDF_PAGES=500
# Corta qpdf/Ghostscript/pdftoppm si un fichero hostil los deja colgados.
PDF_PROCESS_TIMEOUT_SECONDS=180

# --- Biblioteca (T17/T18) ---
MAX_FOLDERS_PER_OWNER=100
MAX_COLLECTION_ITEMS=50
CATALOG_PAGE_SIZE=200

# --- Revisiones de material (T21) ---
# 'auto'   → la revisión se publica en cuanto queda lista (por defecto)
# 'manual' → espera a que el profesor pulse «Publicar revisión»
MATERIAL_REVISION_ACTIVATION=auto
# Una revisión retirada no se purga antes de que caduquen los tokens ya
# emitidos: se aplica el mayor de SESSION_TTL_SECONDS, MEDIA_LINK_TTL_SECONDS y
# estos días de retención.
MATERIAL_REVISION_RETENTION_DAYS=30
MATERIAL_REVISION_KEEP_MIN=2
MATERIAL_ARCHIVE_RETENTION_DAYS=90
MATERIAL_PURGE_INTERVAL_MS=3600000

# -----------------------------------------------------------------------------
# Ajustes finos. Todos tienen un valor por defecto razonable y rara vez se
# tocan; se listan porque `src/config.js` los lee y conviene que no haya
# configuración invisible.
# -----------------------------------------------------------------------------
HOST=0.0.0.0
# Confiar en X-Forwarded-* porque siempre hay un proxy delante.
TRUST_PROXY=loopback,linklocal,uniquelocal
# No afecta a la subida de material: ésa va en streaming, sin pasar por aquí.
BODY_LIMIT=256kb
DB_POOL_MAX=6
DB_SSL=false
LOG_PRETTY=true

# Duración del token de sesión emitido tras un launch LTI.
SESSION_TTL_SECONDS=14400
# Tolerancia al desfase de reloj al validar el id_token de Moodle.
LTI_CLOCK_TOLERANCE=60
LTI_STATE_TTL_SECONDS=600

# Rutas de las herramientas externas. Sólo hace falta cambiarlas si no están en
# el PATH de la imagen del worker.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
QPDF_PATH=qpdf
PDFINFO_PATH=pdfinfo
GHOSTSCRIPT_PATH=gs
PDFTOPPM_PATH=pdftoppm

# Techo duro del listado del catálogo, por si alguien pide ?limit=100000
CATALOG_MAX_PAGE_SIZE=500
