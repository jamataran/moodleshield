# -----------------------------------------------------------------------------
# Variables NO secretas del stack de producción. Este fichero SÍ va al
# repositorio: es el que mueve el despliegue.
#
# El pipeline de CI reescribe IMAGE_TAG y hace commit; Portainer detecta el
# cambio (polling o webhook) y redespliega. Ese es todo el GitOps.
#
# Los secretos (DB_PASSWORD, SESSION_SECRET, …) se definen en las variables de
# entorno del stack en Portainer, que tienen prioridad sobre este fichero.
# -----------------------------------------------------------------------------

IMAGE_REGISTRY=ghcr.io
IMAGE_REPO=jamataran/moodleshield
IMAGE_TAG=latest

# Raíz de datos en el host. Absoluta, siempre.
DATA_ROOT=/docker-apps/moodleshield/prod
# Raíz del repositorio clonado por Portainer, para montar la config de nginx.
INFRA_ROOT=/docker-apps/moodleshield/repo/infra

PUBLIC_URL=https://moodleshield.example.com
BIND_ADDRESS=127.0.0.1
HTTP_PORT=43127

LOG_LEVEL=info
MARK_ALPHA=0.06
WORKER_CPUS=2
WORKER_MEMORY=1536m
MAX_UPLOAD_SIZE=4g
