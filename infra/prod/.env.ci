# Valores de relleno para poder validar el compose sin secretos reales.
# Lo usa el job `infra` de CI y sirve también en local:
#   docker compose --env-file infra/prod/.env --env-file infra/prod/.env.ci \
#     -f infra/prod/compose.yml config
# No contiene ningún secreto: todos los valores son literalmente "ci".

DB_PASSWORD=ci
SESSION_SECRET=ci
WATERMARK_SECRET=ci
MEDIA_KEY_SECRET=ci
MEDIA_LINK_SECRET=ci
IMAGE_REPO=ejemplo/moodleshield
