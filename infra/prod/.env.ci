# Valores de relleno para poder validar el compose sin secretos reales.
# Lo usa el job `infra` de CI y sirve también en local:
#   docker compose --env-file infra/prod/.env.sample --env-file infra/prod/.env.ci \
#     -f infra/prod/compose.yml config
# No contiene ningún secreto: todos los valores son literalmente "ci".

PUBLIC_URL=https://ci.example.invalid
DB_PASSWORD=ci
DB_APP_PASSWORD=ci
DB_WORKER_PASSWORD=ci
SESSION_SECRET=ci
WATERMARK_SECRET=ci
MEDIA_KEY_SECRET=ci
MEDIA_LINK_SECRET=ci
ADMIN_USERNAME=ci
ADMIN_PASSWORD_HASH=ci
ADMIN_SESSION_SECRET=ci
