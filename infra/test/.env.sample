# Plantilla del bloque de variables del stack.
#
# Genera el bloque real (con secretos ya generados) con:
#   ./scripts/generate-env.sh test
# y pégalo en Portainer → Stack → Environment variables → Advanced mode.
#
# Este fichero versionado nunca lleva secretos: sólo sirve de referencia y para
# validar el compose en CI.

DATA_ROOT=/docker-apps/moodleshield-test
PUBLIC_URL=https://moodleshield-test.example.com
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8081
DB_PORT_HOST=55432

DB_NAME=moodleshield
DB_USER=moodleshield
DB_PASSWORD=
SESSION_SECRET=
WATERMARK_SECRET=
MEDIA_KEY_SECRET=
MEDIA_LINK_SECRET=
LTI_ADMIN_TOKEN=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_ALLOW_PRIVATE_LTI_HOSTS=false

LOG_LEVEL=debug
MARK_ALPHA=0.5
WORKER_CPUS=1
WORKER_MEMORY=1024m
MAX_UPLOAD_SIZE=2g
