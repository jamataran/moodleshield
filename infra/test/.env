# -----------------------------------------------------------------------------
# Variables NO secretas del stack de pruebas. Este fichero SÍ va al repositorio.
# El CI reescribe IMAGE_TAG en cada push a main y Portainer redespliega.
# -----------------------------------------------------------------------------

IMAGE_REGISTRY=ghcr.io
IMAGE_REPO=jamataran/moodleshield
IMAGE_TAG=sha-371f3cc

DATA_ROOT=/docker-apps/moodleshield/test
INFRA_ROOT=/docker-apps/moodleshield/repo/infra

PUBLIC_URL=https://moodleshield-test.example.com
BIND_ADDRESS=127.0.0.1
HTTP_PORT=43128
DB_PORT_HOST=55432

LOG_LEVEL=debug
# Marca A/B visible a simple vista: en pruebas es lo que se quiere.
MARK_ALPHA=0.5
WORKER_CPUS=1
WORKER_MEMORY=1024m
MAX_UPLOAD_SIZE=2g
