# -----------------------------------------------------------------------------
# SECRETOS del stack de pruebas.
#
# NO se versionan. Se pegan en Portainer → Stacks → moodleshield →
# Environment variables, o se dejan en un fichero fuera del repositorio.
#
# Generar cada uno con:  openssl rand -hex 32
# -----------------------------------------------------------------------------

DB_NAME=moodleshield
DB_USER=moodleshield
DB_PASSWORD=

# Firma los tokens de sesión emitidos tras cada launch LTI.
SESSION_SECRET=

# Deriva el patrón A/B de cada alumno.
# ⚠️ Cambiarlo invalida todas las trazas forenses anteriores: los vídeos ya
# vistos dejarían de poder atribuirse. Trátalo como un secreto permanente.
WATERMARK_SECRET=

# Firma los tokens que autorizan la descarga de la clave AES de cada vídeo.
MEDIA_KEY_SECRET=

# Compartido entre la app y nginx para firmar las URLs de los segmentos.
# Si los dos no coinciden, nginx devuelve 403 en todos los segmentos.
MEDIA_LINK_SECRET=

# Opcional: habilita POST /lti/platforms para dar de alta Moodles por API.
LTI_ADMIN_TOKEN=

# --- Túnel HTTPS: rellena sólo el que vayas a usar ---
CLOUDFLARE_TUNNEL_TOKEN=
TS_AUTHKEY=
TS_HOSTNAME=moodleshield-test
