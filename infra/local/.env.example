# =============================================================================
# MoodleShield · LOCAL — plantilla de TODO lo que se puede configurar
#
# Este fichero es la lista completa de variables que lee `compose.yml` de esta
# carpeta, con el valor por defecto de cada una y qué significa. No hace falta
# poner ninguna: todas tienen `:-` en el Compose. Está para que no haya
# configuración invisible.
#
# Dónde va cada cosa:
#   .env         se versiona → sólo ajustes NO secretos y NO personales
#   .env.local   gitignorado → secretos, tokens y el nombre de tu túnel
#
#   cp .env.example .env.local        # y borra lo que no vayas a tocar
#   docker compose --env-file .env --env-file .env.local up -d --build
#
# Los scripts de esta carpeta (`up.sh`, `rebuild.sh`…) ya cargan los dos
# ficheros: `lib.sh` da prioridad a `.env.local`.
#
# ⚠️ Los secretos de abajo son valores de desarrollo INSEGUROS a propósito, los
# mismos que el Compose incrusta con `:-`. Se listan para poder copiarlos a un
# cliente (Bruno, curl), no para reutilizarlos fuera de tu equipo.
# =============================================================================

# --- Lo que casi siempre hay que tocar --------------------------------------

# URL pública tal y como la ve Moodle. Sin túnel se queda en localhost; con
# túnel, la URL del túnel (Moodle exige https).
#   Tailscale Funnel  → https://<host>.<tailnet>.ts.net
#   Cloudflare Tunnel → la URL que imprime el contenedor
# Va AQUÍ y no en `.env`, que se versiona en un repositorio público.
PUBLIC_URL=http://localhost:8088

# Token del túnel con nombre de Cloudflare (Zero Trust → Networks → Tunnels).
# Sólo lo usa el perfil `cloudflare`.
CLOUDFLARE_TUNNEL_TOKEN=

# Puerto del host donde publica nginx. Todo entra por aquí, también /api/v1.
HTTP_PORT=8088

# Raíz de los datos persistentes (pgdata, media, uploads). Relativa a esta
# carpeta. No la muevas con material ya subido dentro.
DATA_ROOT=./data

# --- Consola de administración (/admin) --------------------------------------
# Con los tres vacíos, /admin responde 404 (en desarrollo). Genera el hash sin
# escribir la contraseña en ningún sitio:
#   node scripts/hash-admin-password.mjs
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Duración de la sesión de la consola. 28800 = 8 horas.
ADMIN_SESSION_TTL_SECONDS=28800
# Permite dar de alta un Moodle en una IP privada. Amplía la superficie SSRF:
# en local hace falta si tu Moodle vive en la misma LAN o en otro contenedor.
ADMIN_ALLOW_PRIVATE_LTI_HOSTS=false

# --- APIs de integración (/api/v1) -------------------------------------------
# Dos APIs bajo el mismo prefijo, con tokens DISTINTOS y no intercambiables. La
# aplicación rechaza el arranque si coinciden. Con su token vacío, cada una
# responde 404 en todas sus rutas: una API deshabilitada no se anuncia.
#
# En local las DOS vienen encendidas con estos valores de desarrollo, que es lo
# que hace que se puedan probar sin configurar nada. Son los que hay que pegar
# en Bruno (Colección → Environments → local) o pasar a curl.

# API de INFORMES — sólo lectura, la de avances de alumnos (ADR-030).
#   curl -s "http://localhost:8088/api/v1/reports/courses?platformId=<UUID>" \
#        -H "Authorization: Bearer local-reports-api-token-0000000000000000"
# El UUID de la plataforma sale de la consola (URL del botón «Editar») o de
# `GET /api/v1/platforms` con el token de contenido.
REPORTS_API_TOKEN=local-reports-api-token-0000000000000000
# UUID de las instancias Moodle que ese token puede consultar, separados por
# coma. VACÍA = todas, y en desarrollo eso vale. En producción es obligatoria
# cuando hay token: ponerlo sin ella aborta el arranque.
REPORTS_API_ALLOWED_PLATFORM_IDS=

# API de CONTENIDO — escritura. Sube material eligiendo `owner_sub`, es decir
# SUPLANTANDO A CUALQUIER PROFESOR. En local está encendida para poder probar
# la migración masiva; fuera de local se deja apagada y se rota al terminar.
CONTENT_API_TOKEN=local-content-api-token-0000000000000000
# Mismas reglas que la lista de informes.
CONTENT_API_ALLOWED_PLATFORM_IDS=

# Token para dar de alta plataformas por API (POST /lti/platforms). Vacío
# deshabilita ese endpoint; si se rellena, mínimo 32 caracteres (V-06).
LTI_ADMIN_TOKEN=local-inseguro-ltiadmin-00000000000000000000

# --- Secretos ----------------------------------------------------------------
# En local son valores fijos para que la base de datos y los enlaces firmados
# sobrevivan a un `docker compose down`. Si los cambias, las trazas forenses
# anteriores dejan de poder atribuirse y los enlaces ya emitidos caducan.
# ⚠️ MEDIA_LINK_SECRET lo comparten la app y nginx: si difieren, TODOS los
# segmentos devuelven 403.
SESSION_SECRET=local-inseguro-session-00000000000000000000
WATERMARK_SECRET=local-inseguro-watermark-00000000000000000000
MEDIA_KEY_SECRET=local-inseguro-mediakey-00000000000000000000
MEDIA_LINK_SECRET=local-inseguro-medialink-00000000000000000000

# --- Base de datos -----------------------------------------------------------
# El propietario sólo lo usa el bootstrap: el entrypoint le quita la contraseña
# del entorno antes de arrancar la web, que sirve siempre con el rol de app.
# El worker sólo recibe su propio par. Postgres se publica en 127.0.0.1:55432
# para poder inspeccionarlo con psql.
DB_PASSWORD=moodleshield-local
DB_APP_PASSWORD=moodleshield-app-local
DB_WORKER_PASSWORD=moodleshield-worker-local

# --- Red y origen público ----------------------------------------------------
# Otros nombres por los que se alcanza ESTA misma instancia, separados por coma.
# PUBLIC_URL sigue siendo el canónico (el que se registra en Moodle); los alias
# sólo permiten que una petición que entre por otro nombre reciba URLs de ese
# mismo nombre. Con el túnel activo, aquí se queda localhost.
PUBLIC_URL_ALIASES=http://localhost:8088,http://127.0.0.1:8088
# Hay exactamente un nginx controlado delante de Node. No amplíes esta confianza.
TRUST_PROXY=1
# IP real del alumno cuando delante hay un CDN (ADR-019), y la IP es evidencia:
#   auto   → CF-Connecting-IP sólo si viene de un rango publicado de Cloudflare
#   always → confiar siempre; es lo que necesita un túnel cloudflared, donde el
#            borde no aparece en la cadena de proxies
#   never  → ignorar la cabecera
TRUST_CLOUDFLARE_CLIENT_IP=auto
# CIDR extra que cuentan como CDN de confianza, separados por coma.
CDN_TRUSTED_RANGES=

# --- LTI ---------------------------------------------------------------------
# Parámetro personalizado de Moodle con el identificador visible del alumno; es
# la clave con la que la API de informes cruza con una herramienta externa.
# Moodle no manda el username en ningún claim estándar de LTI 1.3: se configura
# en la herramienta como  username=$User.username
LTI_IDENTITY_CUSTOM_PARAM=username
# Lo que se le enseña al administrador de Moodle para que lo copie. Las comillas
# simples impiden que Docker Compose expanda `$User` y lo deje en `.username`;
# dentro del propio compose.yml va escapado como $$User.username.
LTI_IDENTITY_MOODLE_SOURCE='$User.username'
# T24: verificación de la referencia firmada del material en cada launch.
#   warn    → sirve el launch sin firma y deja aviso en el log (por defecto aquí)
#   enforce → rechaza el launch sin firma; es lo que exige producción
#   off     → sólo desarrollo
# Pásalo a `enforce` cuando el aviso deje de aparecer en los logs.
LAUNCH_RESOURCE_SIGNATURE=warn
# Duración del token de sesión emitido tras un launch LTI. 14400 = 4 horas.
SESSION_TTL_SECONDS=14400

# --- Entrega de medios -------------------------------------------------------
# Duración de los enlaces firmados que valida nginx (secure_link). Tiene que
# cubrir el visionado más largo que esperes.
MEDIA_LINK_TTL_SECONDS=14400

# --- Subidas y cuotas --------------------------------------------------------
# Tamaño máximo de un material. En local, 2 GiB.
MAX_UPLOAD_BYTES=2147483648
# Tamaño de cada fragmento del protocolo troceado. Por debajo del máximo de
# 100 MB de Cloudflare Free/Pro, que es lo que obliga a trocear.
UPLOAD_CHUNK_BYTES=16777216
# Cuánto sobrevive una subida a medias antes de liberarse. 86400 = 1 día.
UPLOAD_SESSION_TTL_SECONDS=86400
# Suelo de disco libre por debajo del cual se rechaza reservar una subida.
STORAGE_MIN_FREE_BYTES=1073741824
# Cupos por profesor. -1 = sin límite (en los cuatro).
MAX_ACTIVE_UPLOADS_PER_OWNER=5
# La cola de procesado va sin tope: encolar no consume disco ni CPU, y ponerle
# número obliga a importar una carpeta grande en varias pasadas manuales.
MAX_PENDING_JOBS_PER_OWNER=-1
MAX_RESERVED_UPLOAD_BYTES_PER_OWNER=4294967296
MAX_STORED_BYTES_PER_OWNER=53687091200
# Techos de nginx, en su propia sintaxis. MAX_CHUNK_SIZE tiene que ser MAYOR que
# UPLOAD_CHUNK_BYTES o cada PUT respondería 413.
MAX_UPLOAD_SIZE=2g
MAX_CHUNK_SIZE=32m

# --- Reproducción ------------------------------------------------------------
# IP distintas toleradas para un mismo permiso de reproducción antes de marcarlo
# como sospechoso. Un alumno que cambia de wifi a datos ya usa dos.
PLAYBACK_MAX_DISTINCT_IPS=3
# Si al superarlo se revoca el permiso además de registrarlo. En local, no:
# revocar a mitad de una prueba despista más que ayuda.
PLAYBACK_REVOKE_ON_SUSPICION=false

# --- Transcodificación (vídeo) -----------------------------------------------
# Duración de cada segmento HLS. Fija los cortes que hacen intercambiables A y B.
SEGMENT_SECONDS=4
OUTPUT_FPS=24
# Calidad. Paridad con producción: el Compose local traía 23 y se notaba peor.
OUTPUT_CRF=23
OUTPUT_PRESET=veryfast
# Opacidad de la marca A/B. 0.04–0.08 es imperceptible (lo de producción); en
# local viene a 0.5 a propósito, porque aquí se quiere VER el patrón.
MARK_ALPHA=0.5
# Cuánto tiempo puede un worker retener un trabajo sin dar señales, y cada cuánto
# la da. El heartbeat debe ser sensiblemente menor que el lease.
TRANSCODE_LEASE_SECONDS=90
TRANSCODE_HEARTBEAT_MS=20000
# Cortan ffprobe/ffmpeg si un fichero hostil los deja colgados. 21600 = 6 horas.
TRANSCODE_PROBE_TIMEOUT_SECONDS=30
TRANSCODE_PROCESS_TIMEOUT_SECONDS=21600
# Cota VBV por variante; permite reservar disco y cuota antes de ejecutar ffmpeg.
VIDEO_MAX_OUTPUT_BITRATE_KBPS=8000
# Recorta el lado largo de la salida. 0 = sin recorte. 1080 es lo sensato para un
# reproductor dentro de un iframe: en vídeo vertical de móvil (1440x1920) divide
# por tres los píxeles, y se codifican DOS veces.
VIDEO_MAX_OUTPUT_LONG_SIDE=0
# Límites de lo que se acepta como fuente. Rechazar aquí es barato; descubrirlo
# a mitad de un ffmpeg de seis horas, no.
VIDEO_MAX_DURATION_SECONDS=14400
VIDEO_MAX_PIXELS=8294400
VIDEO_MAX_DIMENSION=4096
VIDEO_MAX_STREAMS=16
VIDEO_MAX_SOURCE_FPS=120
VIDEO_MAX_AUDIO_CHANNELS=8

# --- Materiales PDF ----------------------------------------------------------
# Límite propio: un PDF de 100 MB ya es enorme; un vídeo de 100 MB, corto.
MAX_PDF_BYTES=104857600
MAX_PDF_PAGES=500
# Corta qpdf/Ghostscript/pdftoppm si un fichero hostil los deja colgados.
PDF_PROCESS_TIMEOUT_SECONDS=180

# --- Biblioteca y revisiones -------------------------------------------------
MAX_FOLDERS_PER_OWNER=100
MAX_COLLECTION_ITEMS=50
# 'auto'   → la revisión se publica en cuanto queda lista
# 'manual' → espera a que el profesor pulse «Publicar revisión»
MATERIAL_REVISION_ACTIVATION=auto
# Una revisión retirada no se purga antes de que caduquen los tokens ya
# emitidos: se aplica el mayor de SESSION_TTL_SECONDS, MEDIA_LINK_TTL_SECONDS y
# estos días de retención.
MATERIAL_REVISION_RETENTION_DAYS=30
MATERIAL_REVISION_KEEP_MIN=2
MATERIAL_ARCHIVE_RETENTION_DAYS=90

# --- Diagnóstico -------------------------------------------------------------
# 'debug' en local; 'info' en test y producción.
LOG_LEVEL=debug
