# -----------------------------------------------------------------------------
# Copia este fichero a .env.local (gitignorado) si usas el túnel con nombre:
#   cp .env.example .env.local
#   docker compose --env-file .env --env-file .env.local --profile cloudflare up -d
# -----------------------------------------------------------------------------

# Token del túnel de Cloudflare (Zero Trust → Networks → Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=

# El hostname público que hayas asociado al túnel.
PUBLIC_URL=https://video-dev.tudominio.com
