# -----------------------------------------------------------------------------
# Ajustes NO secretos del entorno local. Este fichero se versiona.
#
# Los secretos de este entorno son valores de desarrollo incrustados en
# compose.yml (inseguros a propósito). Para el túnel con nombre, crea un
# .env.local (gitignorado) a partir de .env.example y arranca con:
#   docker compose --env-file .env --env-file .env.local --profile cloudflare up -d
# -----------------------------------------------------------------------------

HTTP_PORT=8088
# Como en producción (0.06, imperceptible). Para ver el patrón A/B a simple
# vista en una demo, arranca con MARK_ALPHA=0.5 por shell o en .env.local.
MARK_ALPHA=0.06
# Paridad con prod: el compose local traía 23 y la calidad se notaba peor.
OUTPUT_CRF=21
LOG_LEVEL=debug

# Sin túnel. Con túnel, PUBLIC_URL se pasa por shell o por .env.local, NUNCA
# aquí: este fichero se versiona en un repositorio público y el hostname de tu
# tailnet o de tu dominio no pinta nada en él (`lib.sh` da prioridad al valor
# de .env.local, así que basta con declararlo allí).
#   Tailscale Funnel  → https://<host>.<tailnet>.ts.net
#   Cloudflare Tunnel → la URL que imprime el contenedor
PUBLIC_URL=http://localhost:8088

CLOUDFLARE_TUNNEL_TOKEN=
