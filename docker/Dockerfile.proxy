# syntax=docker/dockerfile:1.7
#
# El proxy, con su configuración DENTRO de la imagen.
#
# Antes se montaba `infra/nginx/` desde el host (${INFRA_ROOT}) y eso obligaba a
# mantener un clon del repositorio en una ruta fija del servidor. Portainer clona
# el stack en su propio volumen, no en una ruta estable del host: si nadie había
# clonado el repo a mano en ${INFRA_ROOT}, Docker creaba esos bind mounts como
# directorios vacíos, nginx arrancaba con la configuración por defecto (sin
# /healthz y escuchando en el 80 en vez del 8080) y el healthcheck lo dejaba en
# "unhealthy" para siempre.
#
# Con la configuración horneada aquí, el stack no depende de nada del host: se
# despliega eligiendo el compose y pegando el .env, que es como se opera.

# La rama 1.27 dejó de reconstruirse: su tag sigue apuntando al mismo digest
# sobre Alpine 3.21, con 35 CVE altas/críticas acumuladas (dos de OpenSSL).
# 1.29 es la rama viva, sobre Alpine 3.23, y sigue trayendo `secure_link`,
# que es el módulo del que depende la firma de segmento.
FROM nginx:1.31-alpine@sha256:db35bfc6b2951e7f8a72db5db120288c127ffaeeb4a6d4b95a26fead017d5913

# Lo pasa el bake para las tres imágenes: sirve para que la etiqueta de versión
# de la imagen coincida con la de app y worker, y —igual de importante— para
# invalidar el `apk upgrade` de abajo.
#
# SU POSICIÓN ES DELIBERADA: tiene que ir ANTES del upgrade. Estaba después, y
# como la caché `gha` (mode=max) sólo invalida una capa cuando cambia algo por
# encima, el upgrade quedó congelado: servía los paquetes del día en que se
# construyó esa capa por primera vez. Se vio con CVE-2026-14456 — el gate de
# Trivy tumbó un proxy con openssl 3.5.7-r0 mientras Alpine ya publicaba
# 3.5.8-r0 y este mismo `apk upgrade`, ejecutado de nuevo, lo recogía. Una capa
# de parches de seguridad servida desde caché es peor que no tenerla: da el
# verde sin aplicar nada.
#
# Como el CI pasa el sha del commit, esto se reconstruye en cada build. Cuesta
# unos segundos; el valor es que el upgrade se aplica de verdad, siempre.
ARG APP_VERSION=dev

# La imagen oficial se reconstruye más despacio de lo que Alpine publica
# parches, así que al construir arrastra paquetes con CVE altas ya
# corregidas aguas arriba (openssl, curl, expat, libxml2, nghttp2…). Este
# upgrade las recoge. Es la única capa no reproducible de las tres
# imágenes, y se acepta a propósito: es un proxy que termina TLS.
RUN apk upgrade --no-cache

COPY infra/nginx/templates/ /etc/nginx/templates/
COPY infra/nginx/proxy_headers.conf /etc/nginx/proxy_headers.conf

# El entrypoint oficial pasa envsubst sobre /etc/nginx/templates/*.template y
# escribe el resultado en /etc/nginx/conf.d/. El filtro limita la sustitución a
# estas tres variables, para que $uri, $arg_* y demás variables de nginx lleguen
# intactas a la configuración final.
#
# Los valores por defecto no son decorativos: si llegaran vacíos,
# `client_max_body_size ;` es un error de sintaxis y nginx no arrancaría.
#
# MAX_CHUNK_SIZE acota los PUT del protocolo troceado. Tiene que ser mayor que
# UPLOAD_CHUNK_BYTES (16 MiB por defecto) o cada fragmento responderá 413.
ENV NGINX_ENVSUBST_FILTER="^(MEDIA_LINK_SECRET|MAX_UPLOAD_SIZE|MAX_CHUNK_SIZE)\$" \
    MAX_UPLOAD_SIZE=4g \
    MAX_CHUNK_SIZE=32m

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/_proxy-healthz >/dev/null 2>&1 || exit 1
